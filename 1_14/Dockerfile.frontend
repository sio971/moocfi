FROM ubuntu:24.04
WORKDIR /myapp

ENV REACT_APP_BACKEND_URL="http://localhost:8080"
RUN apt update
RUN apt install -y curl
RUN curl -sL https://deb.nodesource.com/setup_16.x | bash
RUN apt install -y nodejs

# use here COPY 1_12 .
COPY 1_12 .
RUN npm install
RUN npm run build
RUN npm install -g serve
CMD ["serve", "-s", "-l", "5001", "build"]

